# Environment variables (copy to .env and fill in values)

# Broker API
BROKER_BASE_URL=https://api.broker.example.com
BROKER_WS_URL=wss://ws.broker.example.com
BROKER_CLIENT_ID=
BROKER_CLIENT_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=postgres
DB_PASSWORD=

# Token encryption (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Risk thresholds
RISK_DAILY_LOSS_LIMIT=5000
RISK_MAX_DRAWDOWN=10000
RISK_PROFIT_TARGET=50000

# Sentry
SENTRY_DSN=

# Server
PORT=3000
NODE_ENV=production